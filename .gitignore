# ─── Особисті дані (не комітяться ніколи) ────────────────────────────
# Політика golden-логів (design §4.4): сирі логи містять батлтеги й
# Blizzard account id. У git їдуть лише знеособлені зрізи з
# tests/logs/fixtures/ (див. tests/logs/make_fixtures.py).
tests/logs/raw/

# Історія ігор старого формату — містить справжні імена гравців
# (design "Security & privacy": PII → battletags). Мігрується в
# tavernlab.sqlite при першому запуску app.py.
games.jsonl

# Локальний стан застосунку. Design §2.9: усе живе на диску користувача,
# нічого не надсилається назовні.
tavernlab.sqlite
tavernlab.sqlite-wal
tavernlab.sqlite-shm
tavernlab.log
tavernlab.log.*
advisor_cache/
coach_log.md
watcher.pid

# Сирий корпус HearthstoneJSON — вхідні дані для hs2/build_data.py,
# 9 МБ, перезавантажується через `build_data.py --fetch`.
cards.json

# Вихід scripts/build_cards.py (design §2a): злиття живого Blizzard
# card-library API з CardDefs.xml, 9+ МБ, і кеш того самого API.
# Перебудовується через `build_cards.py --include-carddefs-only`.
cards_merged.json
blizzard_api_cache.json

# ─── Артефакти збірки ────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
build/
dist/
*.egg-info/
venv/
.venv/

# ─── Вивід пайплайнів (регенерується скриптами з README) ─────────────
# scripts/run2_optimize.py → optimized2.json → scripts/run2_final.py
#     → results2.json → scripts/make_report.py
optimized2.json
results2.json
report_data.json
site_classic.json
site_std.json

# Консольні захоплення прогонів (містять локальні шляхи /home/…)
*_log.txt
live_out.txt
user_burn_mage_report.txt

# ─── Пісочниця для експериментальних карт (design §4.3) ──────────────
hs2/impls_sandbox.py

# ─── Редактори / IDE ─────────────────────────────────────────────────
.idea/
.vscode/
.ruby-lsp/
*.swp
*~
.DS_Store

# Кеш ілюстрацій (scripts/fetch_art.py). Арт — власність Blizzard:
# кешуємо для особистого використання, у репозиторій не кладемо.
art_cache/
